# LAWLINK Environment Configuration
# To connect your own live cloud services, fill in the values below.
# The application automatically runs with full Cloud Simulation and Seed Data
# if Firebase credentials are empty, and switches seamlessly to live Cloud Firestore when keys are provided!

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_GEMINI_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

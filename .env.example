# Firebase Configuration
# Replace these with your Firebase project credentials from Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Gemini API Key
# Get an API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Google Maps Platform API Key (Requires Maps JavaScript API & Places API)
# Get a key from Google Cloud Console: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=
